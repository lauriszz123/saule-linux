# ============================================================================
# Saule Linux — kernel configuration
# ============================================================================
#
# Only what this file turns on goes into the kernel: the build starts from
# `make allnoconfig` (everything off) and applies this list on top
# (KCONFIG_ALLCONFIG). Kconfig then fills in whatever these options need.
#
# To try an option: `make menuconfig`, then copy the line you changed here so
# it survives a clean build. Group new lines under the heading they belong to.

# ---------------------------------------------------------------------------
# Machine
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_LOCALVERSION="-saule"
CONFIG_DEFAULT_HOSTNAME="saule"
# The frame-pointer unwinder keeps the build free of objtool's ORC tables.
CONFIG_UNWINDER_FRAME_POINTER=y

# ---------------------------------------------------------------------------
# Booting
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# UEFI: the kernel is an EFI program itself, so a USB stick needs no
# bootloader — see `make image` in the roadmap (phase 1).
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ---------------------------------------------------------------------------
# What userspace needs (glibc, Rust std, Saule)
# ---------------------------------------------------------------------------
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y

# ---------------------------------------------------------------------------
# File systems
# ---------------------------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# ---------------------------------------------------------------------------
# Console: serial (for `make run`) and the screen (for `make run-gui`)
# ---------------------------------------------------------------------------
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Pseudo-terminals (/dev/ptmx, /dev/pts): what a terminal app runs its shell
# behind — Saule's `Os.spawnPty`.
CONFIG_UNIX98_PTYS=y

# ---------------------------------------------------------------------------
# Display — the display server draws through DRM (phase 3)
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# QEMU's standard VGA card.
CONFIG_DRM_BOCHS=y
# QEMU's paravirtual GPU, for the netbook profile's window: the guest says
# which part of the screen changed and QEMU copies it, instead of QEMU
# write-protecting the framebuffer to spot changes. That trapping costs the
# guest's CPU on every frame, which a real graphics chip doesn't, and made
# the netbook-speed profile look several times slower than it is.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
# Whatever framebuffer the firmware set up (real PCs booted through UEFI).
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# ---------------------------------------------------------------------------
# Input — keyboard and mouse as /dev/input/event* (phase 3)
# ---------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# USB keyboards, mice and tablets. The netbook's own ports are USB 2.0
# (EHCI, with UHCI for USB 1.1 devices like most mice); newer PCs have
# xHCI. In QEMU a USB *tablet* is the pointer: it reports absolute
# positions, so the mouse follows the desktop's cursor in and out of the
# QEMU window without grabbing it.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---------------------------------------------------------------------------
# Unix sockets — how apps talk to the display server (phase 3)
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
