# ============================================================================
# Saule Linux — kernel configuration
# ============================================================================
#
# Only what this file turns on goes into the kernel: the build starts from
# `make allnoconfig` (everything off) and applies this list on top
# (KCONFIG_ALLCONFIG). Kconfig then fills in whatever these options need.
#
# To try an option: `make menuconfig`, then copy the changed line here so
# it survives a clean build. Group new lines under the heading they belong to.

# ---------------------------------------------------------------------------
# Machine
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_LOCALVERSION="-saule"

# Running cool. Without these a processor stays at one speed and never
# sleeps deeper than a halt, which the netbook's Atom shrugs off and a
# laptop's four cores turn into heat, fan noise and an hour of battery.
#
# How fast: the processor's own driver where it has one (Intel since Sandy
# Bridge, AMD since Zen 2), else the tables ACPI gives (the netbook's
# SpeedStep, older AMD). How deeply it sleeps when idle: Intel's own
# table of states, else ACPI's. And the firmware's say on temperature:
# when to spin the fan, and when to turn off rather than cook.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_THERMAL=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_X86_PKG_TEMP_THERMAL=y

# Sleep, and what a laptop says of itself: its lid and its power button
# (as switches and keys among the input devices), its battery and whether
# it is plugged in (/sys/class/power_supply). `system/` acts on the lid and
# on being asked to sleep; the window manager shows the battery.
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
# A laptop's embedded controller: the small processor that reads the
# battery, the lid and the top row's keys, and that the firmware's own
# code for all three talks to. Since 6.18 it is an option of its own,
# and off unless asked for.
CONFIG_ACPI_EC=y
CONFIG_DEFAULT_HOSTNAME="saule"
# The keys of a laptop's top row that the keyboard itself doesn't send:
# brightness comes from ACPI's video device, and what a maker adds of its
# own (the radio switch, on some the volume) through the firmware's WMI,
# by a driver for each maker. Dell's and HP's are here, being the machines
# this has been prepared for. They arrive as keys among the input devices,
# which Shine names (`brightnessup`, `volumedown`, …) and the window
# manager acts on. ACPI's video device is also a backlight to set where
# the graphics driver offers none.
CONFIG_ACPI_VIDEO=y
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_ACPI_WMI=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_WMI=y
CONFIG_DELL_WMI_DESCRIPTOR=y
CONFIG_DELL_LAPTOP=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y

# The frame-pointer unwinder keeps the build free of objtool's ORC tables.
CONFIG_UNWINDER_FRAME_POINTER=y

# ---------------------------------------------------------------------------
# Booting
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# UEFI: the kernel is an EFI program itself, so a USB stick needs no
# bootloader — see `make image` in the roadmap (phase 1).
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ---------------------------------------------------------------------------
# What userspace needs (glibc, Rust std, Saule)
# ---------------------------------------------------------------------------
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y

# ---------------------------------------------------------------------------
# File systems
# ---------------------------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
# The firmware's name for the computer, in /sys/class/dmi/id/ (product_name,
# sys_vendor): what About This System calls it.
CONFIG_DMIID=y

# ---------------------------------------------------------------------------
# Console: serial (for `make run`) and the screen (for `make run-gui`)
# ---------------------------------------------------------------------------
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Pseudo-terminals (/dev/ptmx, /dev/pts): what a terminal app runs its shell
# behind — Saule's `Os.spawnPty`.
CONFIG_UNIX98_PTYS=y

# ---------------------------------------------------------------------------
# Display — the display server draws through DRM (phase 3)
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# QEMU's standard VGA card.
CONFIG_DRM_BOCHS=y
# QEMU's paravirtual GPU, for the netbook profile's window: the guest says
# which part of the screen changed and QEMU copies it, instead of QEMU
# write-protecting the framebuffer to spot changes. That trapping costs the
# guest's CPU on every frame, which a real graphics chip doesn't, and made
# the netbook-speed profile look several times slower than it is.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
# Whatever framebuffer the firmware set up: UEFI's GOP on newer PCs, or on
# a BIOS PC a VESA mode picked with `vga=` on the kernel command line. The
# fallback for a graphics chip with no driver here (see `make run-vesa`).
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# The netbook's own graphics, the GMA 3150 (Pineview, Intel's Gen3): i915,
# which drives its panel at 1024x600 with a hardware cursor and the panel's
# backlight. Gen3 reaches its memory through the AGP-era GTT, which is
# AGP_INTEL's. QEMU can't emulate the chip, so it is built and probed for
# but first runs on the real machine; it needs no firmware files.
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_DRM_I915=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# ---------------------------------------------------------------------------
# What is plugged in
# ---------------------------------------------------------------------------
# A USB stick or disk somebody plugs in: the file systems such things come
# with (FAT, exFAT, NTFS), the character sets FAT's names are in, and both
# kinds of partition table. `system/` mounts them, the file browser shows
# them.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# A USB sound card or headset.
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# Bluetooth: the kernel's half of it. The radio is nearly always a USB
# device, inside a laptop too (btusb, with the makers' ways of loading
# their firmware); over it run the old protocol (BR/EDR: mice, keyboards
# and headsets since 2004) and the low-energy one. A keyboard or mouse is
# a HID device either way: over the old protocol the kernel's own HIDP,
# over the new one through `uhid`, handed over by BlueZ. BlueZ (the
# daemon, in the image when BLUETOOTH is given to the build) does the
# rest: finding, pairing, connecting.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_UHID=y

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The netbook's hard disk: 2.5-inch SATA on the NM10 chipset, whose SATA
# runs as AHCI or in the old IDE mode (ATA_PIIX) as the BIOS is set; QEMU's
# q35 is AHCI. Disks appear as SCSI disks (/dev/sda), with the partition
# tables already on above, and Saule's data lives in an ext4 file system
# (`init/src/storage.rs`). USB sticks too, as the same kind of disk.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_EXT4_FS=y
# Other machines' disks, for the installer to find: NVMe (most laptops
# since about 2017), eMMC (small ones, soldered on, behind an SDHCI
# controller on PCI or named by ACPI), and virtio (a virtual machine's).
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# Watching a folder for changes: how init notices a name or a time zone
# chosen for the machine (`init/src/system.rs`).
CONFIG_INOTIFY_USER=y

# ---------------------------------------------------------------------------
# Sound
# ---------------------------------------------------------------------------
# ALSA, and the one kind of sound card a PC has had since about 2005: Intel
# High Definition Audio, whose controller is the chipset's and whose codec
# (the chip that does the playing) is one of a few makers'. Realtek's are
# in most laptops, the Inspiron's among them; the netbook's is IDT's
# (SigmaTel); the generic driver plays through any other. HDMI's are the
# graphics chip's own. Shine's `Audio` plays through ALSA; `system/` sets
# the volume, through the card's control device (/dev/snd/controlC0).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC260=y
CONFIG_SND_HDA_CODEC_ALC262=y
CONFIG_SND_HDA_CODEC_ALC268=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_ALC662=y
CONFIG_SND_HDA_CODEC_ALC680=y
CONFIG_SND_HDA_CODEC_ALC861=y
CONFIG_SND_HDA_CODEC_ALC861VD=y
CONFIG_SND_HDA_CODEC_ALC880=y
CONFIG_SND_HDA_CODEC_ALC882=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# The Internet's protocols (IPv4), raw packets for asking for an address
# (DHCP), and drivers for the wired cards a PC is likely to have: Realtek's
# (the Inspiron's, and most laptops'), Intel's, Atheros's (the netbook's),
# Broadcom's, and a virtual machine's. `system/` brings a cable's interface
# up and asks for its address.
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL1C=y
CONFIG_ALX=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_VIRTIO_NET=y

# Wi-Fi: the kernel's 802.11 stack, and the cards' drivers. Intel's (the
# Inspiron's 3165, and most laptops' since about 2012) load a firmware file
# each from /lib/firmware; Atheros's 802.11n cards (some of the netbook's
# kind) need none. Joining a network is wpa_supplicant's doing, which
# `system/` runs and talks to.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
# Broadcom's BCM4313, 43224 and 43225: the card in many netbooks of
# 2010. Its two firmware files are in the image with Intel's
# (scripts/fetch-wifi.sh).
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BCMA=y
CONFIG_BCMA_HOST_PCI=y
CONFIG_BRCMSMAC=y
# Broadcom's older cards, on their older bus (SSB): the HP Mini 210-1000's
# BCM4312 (14e4:4315, the low-power PHY) among them. Their firmware is cut
# out of Broadcom's own driver when the image is built
# (scripts/fetch-wifi.sh).
CONFIG_SSB=y
CONFIG_SSB_PCIHOST=y
CONFIG_SSB_B43_PCI_BRIDGE=y
CONFIG_B43=y
CONFIG_B43_PHY_LP=y
CONFIG_B43_PHY_G=y
CONFIG_B43_PHY_N=y

# ---------------------------------------------------------------------------
# Input — keyboard and mouse as /dev/input/event* (phase 3)
# ---------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# A newer laptop's touchpad. The netbook's is on the PS/2 port, above;
# since about 2014 a laptop's is a HID device on an I2C bus instead (a
# "precision touchpad"), and reaching it takes the whole chain: the
# chipset's low-power I/O block (LPSS) that the I2C controller is part of,
# the controller's driver (DesignWare, on Intel and AMD alike), the pin
# controller the touchpad's interrupt line comes in through — one driver
# per generation of chipset — and then HID over I2C and the multi-touch
# driver. ELAN's older touchpads speak a protocol of their own on the same
# bus. Shine reads what comes out as it reads any touchpad.
CONFIG_I2C=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_I801=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y

# USB keyboards, mice and tablets. The netbook's own ports are USB 2.0
# (EHCI, with UHCI for USB 1.1 devices like most mice); newer PCs have
# xHCI. In QEMU a USB *tablet* is the pointer: it reports absolute
# positions, so the mouse follows the desktop's cursor in and out of the
# QEMU window without grabbing it.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---------------------------------------------------------------------------
# Unix sockets — how apps talk to the display server (phase 3)
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
