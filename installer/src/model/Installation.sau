-- Where the installer is: which page, what was answered (the keyboard's
-- layout, who the computer is for and their password), which disk, and
-- how far an installation under way has got.
--
-- The answers are asked before the disk, so that the last thing before
-- anything is written is what will be erased. They go to the tool that
-- installs in a file (`Tool.install`), and it puts them on the new
-- system's disk.

import shine

from Numbers import Numbers
from Disk import Contents, Disk
from Tool import Tool

-- The steps, in order. Failed can follow Installing.
export enum Page
  Welcome,
  Keyboard,
  Account,
  Disks,
  Confirm,
  Installing,
  Done,
  Failed
end

export class Installation
  page: Page

  -- Every keyboard layout there is to choose from, as {code, name}, and
  -- the one chosen ("us" until another is). None where the stick has no
  -- layouts: the page for them is then passed over.
  layouts: table<table<string>>
  layout: string

  -- Who the computer is for, their password, and the password typed
  -- again.
  person: string
  password: string
  verify: string

  -- The short name their account goes by: what their home folder is
  -- called and what a terminal's prompt says. Made from the full name
  -- as it is typed ("Ada Lovelace" is "adalovelace"), until the person
  -- types one of their own.
  account: string
  accountTyped: boolean

  disks: table<Disk>
  -- The place in `disks` of the one chosen; 0 when none is.
  chosen: integer

  -- The installation under way, and what it last said it was doing
  -- (`saule-install`'s `step` lines: prepare, system, data, boot).
  process: Process?
  step: string
  -- How far it is, from 0 to 1, and how far the bar shows: the bar
  -- follows smoothly instead of jumping.
  reached: float
  shown: float
  -- What it wrote that hasn't ended in a new line yet.
  pending: string
  finished: boolean
  -- Why it stopped, when it failed.
  failure: string

  -- How the installer ends, for init (../init/src/session.rs): 80 turns
  -- the computer off, 81 restarts it, 83 starts Saule Linux from the
  -- stick without installing. 0 while it is still deciding.
  exitCode: integer

  static powerOff: integer = 80
  static restart: integer = 81
  static tryFirst: integer = 83

  -- How fast the bar catches up with the installation: most of the way
  -- in a third of a second.
  static follow: float = 5.0

  fn init()
    self.page = Page.Welcome
    self.layouts = {}
    self.layout = "us"
    self.person = ""
    self.password = ""
    self.verify = ""
    self.account = ""
    self.accountTyped = false
    self.disks = {}
    self.chosen = 0
    self.process = nil
    self.step = ""
    self.reached = 0.0
    self.shown = 0.0
    self.pending = ""
    self.finished = false
    self.failure = ""
    self.exitCode = 0
  end

  -- Read the layouts there are, once.
  fn findLayouts() -> nil
    if #self.layouts > 0 then
      return
    end
    local found: table<table<string>> = {}
    for line in Keyboard.layouts() do
      local fields = String.split(line, "\t")
      if #fields >= 2 then
        Table.insert(found, {fields[1], fields[2]})
      end
    end
    self.layouts = found
  end

  -- Type with `code` from now, in the installer too: the password is
  -- typed on the next page.
  fn useLayout(code: string) -> nil
    if Keyboard.setLayout(code, "") then
      self.layout = code
    end
  end

  -- The name of the layout chosen: "Lithuanian".
  fn layoutName() -> string
    for layout in self.layouts do
      if layout[1] == self.layout then
        return layout[2]
      end
    end
    return "English (US)"
  end

  -- The full name was typed: the short one follows it, unless the
  -- person has typed their own.
  fn named(person: string) -> nil
    self.person = person
    if not self.accountTyped then
      self.account = Installation.shortFrom(person)
    end
  end

  -- The short name was typed. Emptied again, it follows the full name
  -- as before.
  fn accountNamed(account: string) -> nil
    self.account = String.lower(String.trim(account))
    self.accountTyped = self.account != ""
    if not self.accountTyped then
      self.account = Installation.shortFrom(self.person)
    end
  end

  -- Letters with marks on them, and the letter each is without: a short
  -- name is plain small letters. The same table as init's
  -- (../init/src/person.rs), which makes a short name where none was
  -- given.
  static local marked: table<table<string>> = {
    {"àáâãäåāăą", "a"},
    {"çćĉċč", "c"},
    {"ďđ", "d"},
    {"èéêëēĕėęě", "e"},
    {"ĝğġģ", "g"},
    {"ĥħ", "h"},
    {"ìíîïĩīĭįı", "i"},
    {"ĵ", "j"},
    {"ķ", "k"},
    {"ĺļľŀł", "l"},
    {"ñńņň", "n"},
    {"òóôõöøōŏő", "o"},
    {"ŕŗř", "r"},
    {"śŝşšß", "s"},
    {"ţťŧ", "t"},
    {"ùúûüũūŭůűų", "u"},
    {"ýÿŷ", "y"},
    {"źżž", "z"},
  }

  -- A short name made of a full one: its letters and digits, small and
  -- run together, at most 32 of them, not starting with a digit. "" when
  -- the name has none (it is written in another alphabet).
  static fn shortFrom(full: string) -> string
    local text = String.lower(full)
    local out = ""
    for i = 1, String.len(text) do
      local char = String.sub(text, i, i)
      for pair in Installation.marked do
        if String.contains(pair[1], char) then
          char = pair[2]
        end
      end
      local code = String.byte(char, 1) ?? 0
      local letter = code >= 97 and code <= 122
      local digit = code >= 48 and code <= 57
      if String.len(out) < 32 and (letter or (digit and out != "")) then
        out = out .. char
      end
    end
    return out
  end

  -- Whether `name` can be an account's: a small letter, then small
  -- letters, digits, hyphens and underscores.
  static fn validAccount(name: string) -> boolean
    if name == "" or String.len(name) > 32 then
      return false
    end
    for i = 1, String.len(name) do
      local code = String.byte(name, i) ?? 0
      local letter = code >= 97 and code <= 122
      local digit = code >= 48 and code <= 57
      local mark = code == 45 or code == 95
      if not letter and (i == 1 or not (digit or mark)) then
        return false
      end
    end
    return true
  end

  -- What is wrong with the account as typed, said to the person, or ""
  -- when it can go on. A password is not required: without one the
  -- computer starts straight to the desktop.
  fn accountProblem() -> string
    if String.trim(self.person) == "" then
      return "Enter a name."
    end
    if not Installation.validAccount(self.account) then
      return "The account name must start with a letter and contain only lowercase letters and digits."
    end
    if self.account == "root" then
      return "The account name “root” is reserved."
    end
    if String.trim(self.password) != String.trim(self.verify) then
      return "The passwords do not match."
    end
    return ""
  end

  -- The answers as the tool reads them: a line each, and none for what
  -- wasn't answered.
  fn answers() -> string
    local lines: table<string> = {}
    if String.trim(self.person) != "" then
      Table.insert(lines, "person " .. String.trim(self.person))
    end
    if Installation.validAccount(self.account) then
      Table.insert(lines, "account " .. self.account)
    end
    if String.trim(self.password) != "" then
      Table.insert(lines, "password " .. String.trim(self.password))
    end
    if #self.layouts > 0 then
      Table.insert(lines, "keyboard " .. self.layout)
    end
    if #lines == 0 then
      return ""
    end
    return String.join("\n", lines) .. "\n"
  end

  -- Look at the disks again, and choose the one there is when there is
  -- only one a system would go on: the disk inside the computer.
  fn findDisks() -> nil
    self.disks = Tool.disks()
    self.chosen = 0

    local inside = 0
    for i = 1, #self.disks do
      if not self.disks[i].usb then
        inside += 1
        self.chosen = i
      end
    end
    if inside != 1 then
      self.chosen = 0
    end
  end

  fn disk() -> Disk?
    if self.chosen < 1 or self.chosen > #self.disks then
      return nil
    end
    return self.disks[self.chosen]
  end

  -- Start installing on the chosen disk.
  fn start(keepFiles: boolean) -> nil
    local disk = self.disk()
    if disk == nil then
      return
    end

    self.step = "prepare"
    self.reached = 0.0
    self.shown = 0.0
    self.pending = ""
    self.finished = false
    self.failure = ""
    self.page = Page.Installing

    self.process = Tool.install(disk!, keepFiles, self.answers())
    -- The tool has the password now; nothing here needs it again.
    self.password = ""
    self.verify = ""
    if self.process == nil then
      self.fail("The installer is missing from this USB drive.")
    end
  end

  -- Called every frame while installing, `dt` seconds after the last:
  -- read what the installation said, move the bar. True when the window
  -- has something new to show.
  fn advance(dt: float) -> boolean
    if self.page != Page.Installing then
      return false
    end
    local before = self.shown
    local step = self.step

    local process = self.process
    if process != nil then
      self.listen(process!)
    end

    -- The bar closes a share of the distance each frame, and the last
    -- hundredth at once.
    local gap = self.reached - self.shown
    self.shown += gap * Math.min(1.0, dt * Installation.follow)
    if gap < 0.01 then
      self.shown = self.reached
    end

    -- Done only once the bar has shown it.
    if self.finished and self.shown >= 1.0 then
      self.page = Page.Done
      return true
    end
    return self.shown != before or self.step != step or self.page != Page.Installing
  end

  -- Take what `process` has written since last time, a line at a time,
  -- and notice when it has ended.
  local fn listen(process: Process) -> nil
    local said = Bytes.toString(process.read()) ?? ""
    if said != "" then
      local lines = String.split(self.pending .. said, "\n")
      self.pending = lines[#lines]
      for i = 1, #lines - 1 do
        self.heard(lines[i])
      end
    end

    local code = process.poll()
    if code == nil or not process.atEof() then
      return
    end
    self.process = nil
    if code! != 0 or not self.finished then
      local why = String.trim(Bytes.toString(process.readErr()) ?? "")
      if why == "" then
        why = "The installation stopped before it was complete."
      end
      self.fail(why)
    end
  end

  -- One line from `saule-install`: see ../install/src/target.rs.
  local fn heard(line: string) -> nil
    local words = String.split(String.trim(line), " ")
    if words[1] == "step" and #words >= 2 then
      self.step = words[2]
      self.reached = Math.max(self.reached, Installation.startOf(words[2]))
    elseif words[1] == "copied" and #words >= 2 then
      -- Copying the system is the long part: from 10% of the bar to 80%.
      local percent = Numbers.whole(words[2]) ?? 0
      local share = 0.10 + 0.70 * (percent as float) / 100.0
      self.reached = Math.max(self.reached, share)
    elseif words[1] == "done" then
      self.finished = true
      self.reached = 1.0
    end
  end

  -- Where on the bar each step begins.
  static fn startOf(step: string) -> float
    return match step
      case "prepare" then 0.02
      case "system" then 0.10
      case "data" then 0.82
      case "boot" then 0.94
      case _ then 0.0
    end
  end

  -- What the step under way is, said to a person.
  fn doing() -> string
    return match self.step
      case "system" then "Copying Saule Linux…"
      case "data" then "Preparing storage…"
      case "boot" then "Configuring startup…"
      case _ then "Preparing the disk…"
    end
  end

  local fn fail(why: string) -> nil
    self.process = nil
    self.failure = why
    self.page = Page.Failed
  end

  -- Whether the chosen disk has anything on it that installing would lose.
  fn erases() -> boolean
    local disk = self.disk()
    return disk != nil and disk!.contents != Contents.Blank
  end
end
