-- The keyboard's layout: what is printed on its keys. Asked first, since
-- the next page has a password typed on it, and a password typed on the
-- wrong layout is one nobody can type again.
--
-- A search narrows the list, which has the layout chosen at its top.
-- Choosing one types with it at once, and the field under the list is
-- for trying it: what the keys type shows there.

from uikit import *
from model import Installation, Page
from theme import Look
from views import Choice, Entry, PickRow, Step

export class ChooseKeyboard extends View
  installation: Installation
  refresh: Action

  fn init(installation: Installation, refresh: Action, key: string? = nil)
    self.super(key)
    self.installation = installation
    self.refresh = refresh
  end

  fn body(context: BuildContext) -> View
    local installation = self.installation
    local refresh = self.refresh
    local query = context.state("query", "")

    local back = fn()
      installation.page = Page.Welcome
      refresh()
    end
    local onward = fn()
      installation.page = Page.Account
      refresh()
    end

    local tried = context.state("tried", "")

    -- The one chosen first, so it is seen without scrolling; then the
    -- rest by name, or those the search finds.
    local wanted = String.lower(String.trim(query.text("")))
    local listed: table<table<string>> = {}
    for layout in installation.layouts do
      if layout[1] == installation.layout and wanted == "" then
        Table.insert(listed, layout)
      end
    end
    for layout in installation.layouts do
      local named = String.contains(String.lower(layout[2]), wanted)
      local first = layout[1] == installation.layout and wanted == ""
      if not first and (wanted == "" or named or layout[1] == wanted) then
        Table.insert(listed, layout)
      end
    end

    local rows: table<View> = {}
    for layout in listed do
      local code = layout[1]
      local choose = fn()
        installation.useLayout(code)
        refresh()
      end
      Table.insert(
        rows,
        PickRow(layout[2], code == installation.layout, choose, key: code)
      )
    end
    if #rows == 0 then
      local none = Text("No matching layout.").font(Look.bodySize)
      Table.insert(rows, none.foregroundStyle(Look.dimText).centered())
    end
    local fill = StackAlignment.Fill
    local list = VStack(alignment: fill, spacing: 4.0, children: rows)

    local searched = fn(text: string)
      query.set(text)
    end
    local entered = fn(text: string)
      onward()
    end
    local search = Entry(
      query.text(""),
      "Search for a layout",
      searched,
      entered,
      first: true
    )
    local typed = fn(text: string)
      tried.set(text)
    end
    local trial = Entry(tried.text(""), "Type here to test the layout", typed, entered)
    local content = VStack(alignment: fill, spacing: 8.0) do
      show(search)
      ScrollView(child: list).frame(height: 104.0)
      show(trial)
    end

    return Step(
      title: "Select Your Keyboard Layout",
      said: "Choose the layout that matches this keyboard. Current layout: " .. installation.layoutName() .. ".",
      content: content.frame(width: 400.0),
      aside: {Choice.quiet("Back", back)},
      forward: {Choice.main("Continue", onward)}
    )
  end
end
