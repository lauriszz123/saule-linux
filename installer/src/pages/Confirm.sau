-- The last page before anything is written: what will happen to the
-- chosen disk, in words that fit what is on it. An empty disk is simply
-- installed on; one with Windows on it says so and asks to erase; one
-- with Saule Linux already offers to keep its files.

from uikit import *
from model import Contents, Disk, Installation, Page
from views import Choice, Step

export class Confirm extends View
  installation: Installation
  refresh: Action

  fn init(installation: Installation, refresh: Action, key: string? = nil)
    self.super(key)
    self.installation = installation
    self.refresh = refresh
  end

  fn body(context: BuildContext) -> View
    local installation = self.installation
    local refresh = self.refresh
    local disk = installation.disk()!

    local back = fn()
      installation.page = Page.Disks
      refresh()
    end
    local erase = fn()
      installation.start(false)
      refresh()
    end
    local keep = fn()
      installation.start(true)
      refresh()
    end

    local named = disk.title() .. " (" .. disk.size() .. ")"

    if disk.contents == Contents.Blank then
      return Step(
        title: "Install on This Disk?",
        said: named .. " is empty. Saule Linux will use the entire disk.",
        aside: {Choice.quiet("Back", back)},
        forward: {Choice.main("Install", erase)}
      )
    end

    if disk.contents == Contents.Saule then
      return Step(
        title: "Saule Linux Is Already Installed",
        said: named .. " already contains Saule Linux. Reinstall and keep the existing files and settings, or erase the disk and start over.",
        aside: {Choice.quiet("Back", back)},
        forward: {
          Choice.danger("Erase Everything", erase),
          Choice.main("Keep My Files", keep),
        }
      )
    end

    return Step(
      title: "Erase This Disk?",
      said: Confirm.loss(disk, named),
      aside: {Choice.quiet("Back", back)},
      forward: {Choice.danger("Erase and Install", erase)},
      grave: true
    )
  end

  -- What erasing `disk` loses.
  static fn loss(disk: Disk, named: string) -> string
    local last = " Installing erases the entire disk. This cannot be undone."
    return match disk.contents
      case Contents.Windows then
        named .. " contains Windows. Windows and all files on the disk will be erased." .. last
      case Contents.Linux then
        named .. " contains another Linux system. The system and its files will be erased." .. last
      case Contents.Both then
        named .. " contains Windows and another Linux system. Both systems and all files on the disk will be erased." .. last
      case Contents.SauleData then
        named .. " contains Saule Linux data. The data will be erased." .. last
      case _ then
        named .. " contains data. All data on the disk will be erased." .. last
    end
  end
end
